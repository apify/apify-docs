{
  "name": "docs-tests",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Docs-as-tests: extract Console-UI claims from sources/platform docs into a reviewed assertion baseline.",
  "scripts": {
    "extract": "bash scripts/extract.sh",
    "extract:all": "bash scripts/extract-all.sh",
    "check": "node scripts/check-baseline.mjs",
    "check:strict": "node scripts/check-baseline.mjs --strict",
    "test": "node --test scripts/check-baseline.test.mjs"
  }
}
